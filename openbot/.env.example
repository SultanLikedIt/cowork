# OpenBot sidecar env (copy to openbot-upstream/.env after setup-openbot.sh).
#
# Prerequisite: agent-webapp backend with OPENBOT_AGUI_ENABLED=true on :8001.

OPENBOT_SINGLE_USER=true
PORT=3001
DATABASE_URL=postgres://openbot:openbot@localhost:5432/openbot
KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TENANT_PACKAGE_DIR=../agent-webapp-langgraph/openbot/tenant

# Point OpenBot's remote coworker at this repo's backend AG-UI bridge.
AGENT_WEBAPP_AG_UI_URL=http://localhost:8001/ag-ui
MANAGED_AGENT_AG_UI_URL=http://localhost:8001/ag-ui
MANAGED_AGENT_TOKEN=change-me-openbot-token

# Must match backend OPENBOT_AGUI_TOKEN when auth is enabled.
OPENAI_API_KEY=

# CopilotKit Intelligence — run from openbot-upstream/:
#   npx --yes copilotkit@latest login
#   npx --yes copilotkit@latest project select
#   npx --yes copilotkit@latest license --write
INTELLIGENCE_API_KEY=

COMPUTER_TOKEN=change-me-computer-token
SUPERVISOR_TOKEN=change-me-supervisor-token
MANAGED_AGENT_TOKEN=change-me-openbot-token

# Keep the Windows-only offline bundle and the full CAMEL source checkout
# out of the build context -- neither is needed to build the image
# (camel-ai installs from vendor/camel-offline-bundle-linux instead) and
# together they are hundreds of MB.
vendor/camel-offline-bundle
vendor/camel-source

# Local dev/runtime state that must not be baked into the image.
app.db
app.db-wal
app.db-shm
uploads/
workspaces/
logs/
reliability-results/
bench_*.log
bench_result_*.json
__pycache__/
*.pyc
.env

# Local dev virtualenvs -- the image builds its own via requirements.txt
# (plus the separate crawl4ai/playwright install, see requirements.txt);
# copying a host venv in bakes macOS-built binaries (e.g. torch's
# libtorch_cpu.dylib) into a Linux image and needlessly bloats the build
# context (1-2GB).
venv/
.venv/
latency-results/

# Bu dosyayi kopyala ve adini .env yap:
#   copy .env.example .env
#
# Docker Compose repo KOKUNDEKI .env dosyasini otomatik okur.
# Host'ta dogrudan uvicorn calistiriyorsan model_config.py backend/.env yukler
# -- o durumda dosyayi backend/ altina da koy.
#
# .env .gitignore'da; anahtari commit'leme.


# ============ Model (ZORUNLU) ============
# OpenAI uyumlu chat-completions endpoint'i. Sondaki /v1 onemli.
#
# OpenRouter ornegi:
#   MODEL_BASE_URL=https://openrouter.ai/api/v1
#   MODEL_NAME=deepseek/deepseek-v4-flash
#
# Host'ta calisan Ollama ornegi:
#   MODEL_BASE_URL=http://host.docker.internal:11434/v1
#   MODEL_NAME=qwen2.5:7b
#   MODEL_API_KEY=ollama
MODEL_BASE_URL=https://example.invalid/v1
MODEL_NAME=replace-me
MODEL_API_KEY=replace-me


# ============ Web aramasi ============
# false yaparsan yalniz SearXNG kullanilir.
AGENT_SEARCH_ENABLED=true
# AGENT_SEARCH_BASE_URL=http://agent-search:3939
# AGENT_SEARCH_TOKEN=
# AGENT_SEARCH_TIMEOUT_SECONDS=20
# SearXNG + AgentSearch ayni anda baslar; AgentSearch SearXNG'den sonra en fazla bu kadar beklenir.
# AGENT_SEARCH_GRACE_SECONDS=1.5
# Genel aramada AgentSearch: off (varsayilan; SearXNG motorlarini ikinci kez sorar, yeni sonuc katmiyordu)
# | reference (Wikipedia+Wikidata) | general (eski davranis). Haber aramalari her durumda kullanir.
# AGENT_SEARCH_GENERAL_MODE=off

# BGE reranker: her arama turundaki LLM URL secim cagrisinin yerine gecer.
# Agirliklari bir kez indir (sonra backend imajini yeniden build et):
#   huggingface-cli download BAAI/bge-reranker-v2-m3 --local-dir backend/vendor/bge-reranker-v2-m3
# Agirlik yoksa otomatik olarak LLM secimine duser.
# RERANKER_ENABLED=true
# RERANKER_MODEL_PATH=/app/vendor/bge-reranker-v2-m3
# RERANKER_THREADS=4

# Deep research modu (yalniz Workforce + "Deep research" acikken):
#   survey (varsayilan) = acilari bastan planla, sonda 40 sayfayi kirpip tek cevap yaz
#   iter = her turda raporu bastan yazan dongu (IterResearch); sayfalar tam okunur,
#          bulgular [E#] kaynak kimligiyle rapora islenir. docs/web-execution.md
# DEEP_RESEARCH_MODE=survey
# ITER_MAX_ROUNDS=20
# ITER_MIN_SEARCHES=6
# ITER_REPORT_MAX_CHARS=10000

# Backend'i host'ta calistiriyorsan (Docker disi) bunlari ac:
# SEARXNG_BASE_URL=http://127.0.0.1:8080
# AGENT_SEARCH_BASE_URL=http://127.0.0.1:3939


# ============ "Bilgisayarimda ac" (opsiyonel) ============
# Ayrica host'ta calistir:  python scripts/local_computer_bridge.py
# Yalniz ayni makine; dosya allow-list dizini (varsayilan Downloads) disina yazilmaz.
LOCAL_COMPUTER_ENABLED=false
LOCAL_COMPUTER_URL=http://host.docker.internal:8765


# ============ Outlook ile e-posta (opsiyonel, Windows + klasik Outlook) ============
# Zamanlanmis gorev sonuclarini Outlook'tan e-postayla gonderir. Ayrinti: docs/outlook.md
# Kopru ayni token ile baslatilmali:
#   python scripts/local_computer_bridge.py --token <LOCAL_COMPUTER_TOKEN degeri>
# Token uret:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OUTLOOK_ENABLED=false
LOCAL_COMPUTER_TOKEN=
# SCHEDULE_DELIVERY_MAX_ATTEMPTS=10     # gonderilemeyen e-posta icin deneme sayisi (~6 saat)
# Sohbette "... ve ali@x.com'a gonder" dendiginde: draft = Outlook'ta taslak acilir
# (varsayilan, kullanici Gonder'e basar), send = dogrudan gonderilir.
# OUTLOOK_AGENT_ACTION=draft
#
# --- Posta kutusunu OKUMA (ayri bir izin) ---
# true yapilinca Workforce "gelen maillerime bak", "ahmetten gelen faturayi
# ozetle" gibi isteklerde Gelen Kutusu ve Gonderilmis Ogeler'i okuyabilir;
# ekleri de is klasorune indirip Docling ile okur. Salt okunur: hicbir mail
# okundu isaretlenmez, tasinmaz, silinmez. Baska klasor okunmaz.
# OUTLOOK_ENABLED ayrica true olmali ve kopru token ile calismali.
# Kapaliyken (varsayilan) ajan posta kutusuna hic erisemez.
OUTLOOK_READ_ENABLED=false


# ============ Zamanlanmis gorevler (opsiyonel) ============
# Arayuzde sol menude "Scheduled". Ayrinti: docs/scheduling.md
# SCHEDULING_ENABLED=true
# SCHEDULE_TICK_SECONDS=30              # zamani gelen gorevlere bakma araligi
# SCHEDULE_MAX_CONCURRENT=2             # ayni anda en fazla kac zamanlanmis is
# SCHEDULE_CATCHUP_WINDOW_HOURS=6       # sunucu kapaliyken kacan calisma bu sure icindeyse bir kez telafi edilir
# SCHEDULE_MAX_TASKS_PER_WORKSPACE=20
# SCHEDULE_MIN_INTERVAL_MINUTES=60      # iki calisma arasi en kisa sure
# SCHEDULE_MIN_DEEP_INTERVAL_HOURS=24   # derin arastirma acik gorevler icin
# SCHEDULE_MAX_CONSECUTIVE_FAILURES=3   # art arda bu kadar hatada gorev otomatik duraklatilir
# SCHEDULE_DEFAULT_TIMEZONE=Europe/Istanbul
# SCHEDULE_MAX_CHAIN_DEPTH=3            # zincirde ilk gorevden sonra en fazla kac baglanti
# SCHEDULE_MAX_CHAINED_RUNS_PER_DAY=10  # bir zincirin 24 saatte baslatabilecegi zincir calismasi


# ============ Opsiyonel sinirlar (compose default'lari yeter) ============
# WEB_REQUEST_TIMEOUT_SECONDS=15
# Sayfa acma turu: bu kadar sayfa geldiyse yavas kalanlari bekleme
# WEB_FETCH_ENOUGH_SUCCESSES=2
# WEB_FETCH_STRAGGLER_GRACE_SECONDS=6   # ilk basarili sayfadan sonra kalanlara taninan sure
# WEB_FETCH_SETTLE_GRACE_SECONDS=1.5    # yeterli sayfa geldikten sonra taninan sure
# DOCUMENT_BLOCKS=true
# DOCUMENT_SLIDES=true   # PowerPoint: model slaytlari tasarlar (tablo, grafik, notlar); false = eski notlardan kesilen deste
# DOCUMENT_PDF_ENGINE=chromium
# DOCUMENT_PDF_TIMEOUT_SECONDS=45
# Kurumsal sablon (renk + logo): proje/brand/ klasoru, bkz. brand/README.md.
# Bos birakirsan (BRAND_DIR=) belgeler yerlesik gorunume doner.
# BRAND_DIR=/app/brand
# Document LLM (OpenRouter) ayarlari -- bos birakmak onerilir. deepseek-v4-flash
# ile olculdu: "low" efor kapali dusunmeyi ACIYOR (2-3x yavas); "throughput"
# siralamasi hiz kazandirmadi. Bkz. docs/document-generation.md.
# DOCUMENT_LLM_REASONING_EFFORT=
# DOCUMENT_LLM_PROVIDER_SORT=
# Coding Agent (kod yaz / calistir / duzelt). Ayni anlamda; bos birakmak onerilir.
# Bir cagri bu sureyi asarsa kesilir ve bir kez yeniden denenir (bir saglayici
# butun butceyi dusunmeye harcayip metin dondurmedi: 325 sn).
# CODING_LLM_REASONING_EFFORT=
# CODING_LLM_PROVIDER_SORT=
# CODING_LLM_TIMEOUT_SECONDS=150

# OCR: PDF ve gorsel (png/jpg/tiff...) yuklemelerinden metin okur.
# Compose'ta varsayilan acik. false yaparsan taranmis PDF bos gelir, gorsel
# yuklemesi reddedilir.
#
# Varsayilan motor PaddleOCR-VL-1.6 (Turkce destekli): gorseller ve metin
# katmani olmayan (taranmis) PDF sayfalari paddleocr-vl-api servisine gider;
# metin katmani olan PDF sayfalari Docling'in birebir metniyle okunur.
# Tablo/duzen cok iyi, ama ı->i ve ğ->g hatasi yapar (bkz.
# docs/document-ingestion.md "Measured quality"). O servis "paddleocr" profiliyle calisir ve
# NVIDIA GPU ister (compute capability >= 8.0, vLLM imajinin CUDA'sini
# destekleyen guncel surucu). Servis kapaliysa veya hata verirse ayni yukleme
# otomatik olarak Docling + Tesseract ile okunur; manifest'te
# parser.fallback_reason yazar.
# COMPOSE_PROFILES=paddleocr     # PaddleOCR-VL servislerini de baslat
# DOCLING_ENABLE_OCR=true
# OCR_ENGINE=paddleocr_vl        # paddleocr_vl | tesseract | easyocr | rapidocr
# OCR_FALLBACK_ENGINE=tesseract  # paddleocr_vl calismazsa: tesseract | easyocr | rapidocr
# OCR_LANGS=tur,eng              # Docling motorunun (yedek) kendi dil kodlari
# OCR_FORCE_FULL_PAGE=false      # true = Docling her sayfayi OCR'lar (yavas)
# PADDLEOCR_VL_URL=http://paddleocr-vl-api:8080
# PADDLEOCR_VL_TIMEOUT_SECONDS=240   # DOCLING_PARSE_TIMEOUT_SECONDS'tan kucuk tut
# PADDLEOCR_VL_ORIENTATION=true      # yan/ters taranmis sayfalari duzelt
# PADDLEOCR_VL_UNWARPING=false       # telefonla cekilmis kivrik sayfalari duzelt
# PADDLEOCR_VLM_GPU_MEMORY_UTILIZATION=0.6
# PDF_TEXT_LAYER_MIN_CHARS=20        # bu kadar metin katmani karakteri olan sayfa Docling'de kalir
# DOCLING_PARSE_TIMEOUT_SECONDS=300
# DOCLING_ARTIFACTS_PATH=/app/vendor/docling-models

# Docker'da /data, yerelde backend/. Elle degistirmen genelde gerekmez.
# DATA_DIR=/data

# UYARI: testleri CANLI veritabanina baglar. Production volume'da KULLANMA.
# PYTEST_USE_REAL_DATA_DIR=1

# --- Reddit okuma (opsiyonel) ----------------------------------------------
# Herkese acik Reddit tartismalarini okur (backend/social/).
# Reddit'in anonim erisimi YOKTUR: rdt-cli imajda kurulu gelir ama ayrica
# gecerli bir oturum cerezi gerekir. Kurulum: docs/social-reach.md
#
# Cerez dosyasinin yeri (kap icinde /data altinda, yeniden derlemede silinmez):
#   /data/social-sessions/home/.config/rdt-cli/credential.json
# Cerez ~7 gunde bir elle yenilenmelidir; tarayici olmadan kendini
# yenileyemez. Durum: GET /integrations/social/status
SOCIAL_HOME=/data/social-sessions/home
SOCIAL_MAX_CONCURRENT=2

# --- Jira okuma (opsiyonel) ------------------------------------------------
# Sirket Jira'sindaki kayitlari arar ve okur (backend/jira_client.py).
# YALNIZ OKUR: kayit acmaz, duzenlemez, yorum yazmaz. Kurulum: docs/jira.md
#
# Jira Cloud (*.atlassian.net): JIRA_USERNAME = hesabin e-postasi,
#   JIRA_API_TOKEN = id.atlassian.com > Security > API tokens
# Jira Server / Data Center: JIRA_PERSONAL_TOKEN = profil > Personal Access Tokens
# Mumkunse yalniz okuma yetkisi olan bir hesap kullanin: bu uygulamada giris
# yoktur, arayuze erisen herkes bu hesabin gordugu kayitlari sorgulayabilir.
# Durum: GET /integrations/jira/status
JIRA_ENABLED=false
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PERSONAL_TOKEN=
# auto (varsayilan): *.atlassian.net -> cloud, digerleri -> server
# JIRA_DEPLOYMENT=auto
# Jira VPN arkasindaysa baglanti bu surede kesilir ve "VPN bagli mi?" denir.
# JIRA_CONNECT_TIMEOUT_SECONDS=5
# JIRA_TIMEOUT_SECONDS=20


# ============ Confluence (salt okunur) ============
# Jira hesabini kullanir (JIRA_USERNAME + JIRA_API_TOKEN ya da
# JIRA_PERSONAL_TOKEN). Atlassian Cloud'da adres otomatik: JIRA_URL + /wiki.
# CONFLUENCE_SPACES zorunlu: ajan YALNIZ bu space'lerde arar ve okur.
# Bos birakilirsa ozellik kapali sayilir. Ayrinti: docs/confluence.md
CONFLUENCE_ENABLED=false
CONFLUENCE_SPACES=
# Confluence Jira'dan ayri bir sunucudaysa (Server/DC):
# CONFLUENCE_URL=https://confluence.sirket.com
# CONFLUENCE_PERSONAL_TOKEN=
# CONFLUENCE_USERNAME= / CONFLUENCE_API_TOKEN=   # Jira'dakinden farkliysa

# --- GitHub okuma ----------------------------------------------------------
# Herkese acik GitHub'da depo arar; baglantisi verilen depo, dosya, issue ve
# PR'lari okur (backend/github_client.py). YALNIZ OKUR. Kurulum: docs/github.md
#
# Varsayilan olarak acik ve token gerektirmez; ama tokensiz sinir TUM
# kullanicilar icin saatte 60 istektir (bir depo ozeti ~3 istek). Token ile
# saatte 5.000. Token: github.com/settings/personal-access-tokens/new >
#   Fine-grained > Repository access: Public repositories > izin ekleme.
# Durum: GET /integrations/github/status
GITHUB_ENABLED=true
GITHUB_TOKEN=
# GitHub Enterprise Server icin: https://sunucu/api/v3
# GITHUB_API_URL=https://api.github.com

# --- Workspace belge arama (Knowledge Agent) --------------------------------
# Workspace'e yuklenen belgelerde arar ve bulunan bolumleri dosya + sayfa
# etiketiyle ([K1], [K2] ...) cevaba verir (backend/knowledge_*.py).
# Hesap gerektirmez; indeks DATA_DIR/knowledge.db'dedir, silinirse acilista
# yeniden kurulur. Ayrinti ve olcumler: docs/knowledge.md
KNOWLEDGE_ENABLED=true
# Yeni yuklenen bir belgenin indekslenmesini soru aninda en fazla bu kadar bekle.
# KNOWLEDGE_INDEX_WAIT_SECONDS=20

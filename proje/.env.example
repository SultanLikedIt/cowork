# Bu dosyayi kopyala ve adini .env yap:
#   copy .env.example .env
#
# Docker Compose repo KOKUNDEKI .env dosyasini otomatik okur.
# Host'ta dogrudan uvicorn calistiriyorsan model_config.py backend/.env yukler
# -- o durumda dosyayi backend/ altina da koy.
#
# .env .gitignore'da; anahtari commit'leme.


# ============ Model (ZORUNLU) ============
# OpenAI uyumlu chat-completions endpoint'i. Sondaki /v1 onemli.
#
# OpenRouter ornegi:
#   MODEL_BASE_URL=https://openrouter.ai/api/v1
#   MODEL_NAME=deepseek/deepseek-v4-flash
#
# Host'ta calisan Ollama ornegi:
#   MODEL_BASE_URL=http://host.docker.internal:11434/v1
#   MODEL_NAME=qwen2.5:7b
#   MODEL_API_KEY=ollama
MODEL_BASE_URL=https://example.invalid/v1
MODEL_NAME=replace-me
MODEL_API_KEY=replace-me


# ============ Ajan calistirici ============
# langgraph = bu kopyanin asil amaci
# camel     = eski CAMEL yolu (kod default'u -- bos birakirsan buraya duser)
AGENT_EXECUTOR=langgraph


# ============ Web aramasi ============
# false yaparsan yalniz SearXNG kullanilir.
AGENT_SEARCH_ENABLED=true
# AGENT_SEARCH_BASE_URL=http://agent-search:3939
# AGENT_SEARCH_TOKEN=
# AGENT_SEARCH_TIMEOUT_SECONDS=20
# SearXNG + AgentSearch ayni anda baslar; AgentSearch SearXNG'den sonra en fazla bu kadar beklenir.
# AGENT_SEARCH_GRACE_SECONDS=1.5
# Genel aramada AgentSearch: off (varsayilan; SearXNG motorlarini ikinci kez sorar, yeni sonuc katmiyordu)
# | reference (Wikipedia+Wikidata) | general (eski davranis). Haber aramalari her durumda kullanir.
# AGENT_SEARCH_GENERAL_MODE=off

# BGE reranker: her arama turundaki LLM URL secim cagrisinin yerine gecer.
# Agirliklari bir kez indir (sonra backend imajini yeniden build et):
#   huggingface-cli download BAAI/bge-reranker-v2-m3 --local-dir backend/vendor/bge-reranker-v2-m3
# Agirlik yoksa otomatik olarak LLM secimine duser.
# RERANKER_ENABLED=true
# RERANKER_MODEL_PATH=/app/vendor/bge-reranker-v2-m3
# RERANKER_THREADS=4

# Backend'i host'ta calistiriyorsan (Docker disi) bunlari ac:
# SEARXNG_BASE_URL=http://127.0.0.1:8080
# AGENT_SEARCH_BASE_URL=http://127.0.0.1:3939


# ============ "Bilgisayarimda ac" (opsiyonel) ============
# Ayrica host'ta calistir:  python scripts/local_computer_bridge.py
# Yalniz ayni makine; dosya allow-list dizini (varsayilan Downloads) disina yazilmaz.
LOCAL_COMPUTER_ENABLED=false
LOCAL_COMPUTER_URL=http://host.docker.internal:8765


# ============ Zamanlanmis gorevler (opsiyonel) ============
# Arayuzde sol menude "Scheduled". Ayrinti: docs/scheduling.md
# SCHEDULING_ENABLED=true
# SCHEDULE_TICK_SECONDS=30              # zamani gelen gorevlere bakma araligi
# SCHEDULE_MAX_CONCURRENT=2             # ayni anda en fazla kac zamanlanmis is
# SCHEDULE_CATCHUP_WINDOW_HOURS=6       # sunucu kapaliyken kacan calisma bu sure icindeyse bir kez telafi edilir
# SCHEDULE_MAX_TASKS_PER_WORKSPACE=20
# SCHEDULE_MIN_INTERVAL_MINUTES=60      # iki calisma arasi en kisa sure
# SCHEDULE_MIN_DEEP_INTERVAL_HOURS=24   # derin arastirma acik gorevler icin
# SCHEDULE_MAX_CONSECUTIVE_FAILURES=3   # art arda bu kadar hatada gorev otomatik duraklatilir
# SCHEDULE_DEFAULT_TIMEZONE=Europe/Istanbul


# ============ Opsiyonel sinirlar (compose default'lari yeter) ============
# WEB_REQUEST_TIMEOUT_SECONDS=15
# Sayfa acma turu: bu kadar sayfa geldiyse yavas kalanlari bekleme
# WEB_FETCH_ENOUGH_SUCCESSES=2
# WEB_FETCH_STRAGGLER_GRACE_SECONDS=6   # ilk basarili sayfadan sonra kalanlara taninan sure
# WEB_FETCH_SETTLE_GRACE_SECONDS=1.5    # yeterli sayfa geldikten sonra taninan sure
# DOCUMENT_BLOCKS=true
# DOCUMENT_PDF_ENGINE=chromium
# DOCUMENT_PDF_TIMEOUT_SECONDS=45
# Document LLM (OpenRouter) ayarlari -- bos birakmak onerilir. deepseek-v4-flash
# ile olculdu: "low" efor kapali dusunmeyi ACIYOR (2-3x yavas); "throughput"
# siralamasi hiz kazandirmadi. Bkz. docs/document-generation.md.
# DOCUMENT_LLM_REASONING_EFFORT=
# DOCUMENT_LLM_PROVIDER_SORT=

# OCR: PDF ve gorsel (png/jpg/tiff...) yuklemelerinden metin okur.
# Compose'ta varsayilan acik. false yaparsan taranmis PDF bos gelir, gorsel
# yuklemesi reddedilir.
#
# Varsayilan motor PaddleOCR-VL-1.6 (Turkce destekli): gorseller ve metin
# katmani olmayan (taranmis) PDF sayfalari paddleocr-vl-api servisine gider;
# metin katmani olan PDF sayfalari Docling'in birebir metniyle okunur.
# Tablo/duzen cok iyi, ama ı->i ve ğ->g hatasi yapar (bkz.
# docs/document-ingestion.md "Measured quality"). O servis "paddleocr" profiliyle calisir ve
# NVIDIA GPU ister (compute capability >= 8.0, vLLM imajinin CUDA'sini
# destekleyen guncel surucu). Servis kapaliysa veya hata verirse ayni yukleme
# otomatik olarak Docling + Tesseract ile okunur; manifest'te
# parser.fallback_reason yazar.
# COMPOSE_PROFILES=paddleocr     # PaddleOCR-VL servislerini de baslat
# DOCLING_ENABLE_OCR=true
# OCR_ENGINE=paddleocr_vl        # paddleocr_vl | tesseract | easyocr | rapidocr
# OCR_FALLBACK_ENGINE=tesseract  # paddleocr_vl calismazsa: tesseract | easyocr | rapidocr
# OCR_LANGS=tur,eng              # Docling motorunun (yedek) kendi dil kodlari
# OCR_FORCE_FULL_PAGE=false      # true = Docling her sayfayi OCR'lar (yavas)
# PADDLEOCR_VL_URL=http://paddleocr-vl-api:8080
# PADDLEOCR_VL_TIMEOUT_SECONDS=240   # DOCLING_PARSE_TIMEOUT_SECONDS'tan kucuk tut
# PADDLEOCR_VL_ORIENTATION=true      # yan/ters taranmis sayfalari duzelt
# PADDLEOCR_VL_UNWARPING=false       # telefonla cekilmis kivrik sayfalari duzelt
# PADDLEOCR_VLM_GPU_MEMORY_UTILIZATION=0.6
# PDF_TEXT_LAYER_MIN_CHARS=20        # bu kadar metin katmani karakteri olan sayfa Docling'de kalir
# DOCLING_PARSE_TIMEOUT_SECONDS=300
# DOCLING_ARTIFACTS_PATH=/app/vendor/docling-models

# Docker'da /data, yerelde backend/. Elle degistirmen genelde gerekmez.
# DATA_DIR=/data

# UYARI: testleri CANLI veritabanina baglar. Production volume'da KULLANMA.
# PYTEST_USE_REAL_DATA_DIR=1
